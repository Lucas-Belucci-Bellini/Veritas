{
  "name": "veritas",
  "private": true,
  "version": "0.9.0-rc.9",
  "type": "module",
  "description": "Calculadora de tabelas verdade e simulador de circuitos logicos, 100% no navegador.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.mcp.json",
    "chips:import": "npm run build:lib && node scripts/import-dls-chips.mjs",
    "lint": "oxlint",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "build:mcp:http": "vite build --config vite.mcp-http.config.ts",
    "mcp:http": "node mcp/dist/http-server.js",
    "beta:mcp:http": "node scripts/mcp-http-acceptance.mjs",
    "test:rust": "cargo test --manifest-path engine-rs/Cargo.toml --offline",
    "bench:rust": "cargo bench --manifest-path engine-rs/Cargo.toml --offline --bench throughput",
    "bench:compare": "node scripts/engine-comparison-benchmark.mjs",
    "beta:rust": "node scripts/rust-engine-acceptance.mjs",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "smoke:release": "node scripts/smoke-release.mjs",
    "beta:preflight": "bash scripts/beta-preflight.sh",
    "beta:rls": "node scripts/rls-acceptance.mjs",
    "beta:edge": "node scripts/edge-acceptance.mjs",
    "beta:realtime": "node scripts/realtime-acceptance.mjs",
    "beta:hdl": "node scripts/hdl-acceptance.mjs",
    "beta:accessibility": "node scripts/accessibility-acceptance.mjs",
    "beta:mobile": "node scripts/mobile-acceptance.mjs",
    "beta:rollback": "node scripts/rollback-acceptance.mjs",
    "beta:onboarding": "node scripts/onboarding-acceptance.mjs",
    "beta:mcp": "node scripts/mcp-acceptance.mjs",
    "beta:readiness": "node scripts/beta-readiness.mjs",
    "release:guard": "node scripts/release-promotion-guard.mjs",
    "beta:evidence": "node scripts/aggregate-beta-evidence.mjs",
    "validate:plugin": "claude plugin validate . --strict && claude plugin validate ./plugins/veritas-logic --strict"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "@xyflow/react": "^12.11.2",
    "dexie": "^4.4.4",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
